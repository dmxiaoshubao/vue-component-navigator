{
  "name": "vue-component-navigator",
  "displayName": "Vue Component Navigator",
  "description": "Vue 2 and Vue 3 navigation, references, hover, and completions for static component relationships.",
  "version": "1.2.1",
  "publisher": "dmxiaoshubao",
  "author": "dmxiaoshubao",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmxiaoshubao/vue-component-navigator.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "navigation",
    "refs",
    "emit",
    "props",
    "provide",
    "inject",
    "mixins"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "onCommand:vueComponentNavigator.showStatus",
    "onCommand:vueComponentNavigator.reindexWorkspace"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vueComponentNavigator.showStatus",
        "title": "Vue Component Navigator: Show Status"
      },
      {
        "command": "vueComponentNavigator.reindexWorkspace",
        "title": "Vue Component Navigator: Reindex Workspace"
      }
    ],
    "configuration": {
      "title": "Vue Component Navigator",
      "properties": {
        "vueComponentNavigator.entry": {
          "scope": "resource",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "default": [],
          "markdownDescription": "Event Bus registration entry file or files. Supports workspace-relative paths and aliases defined in `jsconfig.json` or `tsconfig.json`, such as `src/main.js` or `@/bootstrap`. When set, only these entries are used before checking one layer of their literal imports."
        }
      }
    },
    "languages": [
      {
        "id": "vue",
        "aliases": [
          "Vue",
          "vue"
        ],
        "extensions": [
          ".vue"
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "compile": "node esbuild.config.mjs",
    "watch": "tsc -watch -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run typecheck && npm run compile",
    "package:vsix": "vsce package --baseImagesUrl https://raw.githubusercontent.com/dmxiaoshubao/vue-component-navigator/main"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
